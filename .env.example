# ==============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================

# Server configuration
PORT=5000
NODE_ENV=development

# Database configuration
# Railway auto-sets DATABASE_URL when you add a PostgreSQL plugin
DATABASE_URL=postgresql://postgres:password@localhost:5432/arabic_platform

# Connection Pool Options (optional)
DB_POOL_MAX=20

# JWT — CHANGE THIS to a long random string in production!
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_SECRET_HERE
JWT_EXPIRES_IN=7d

# CORS — comma-separated list of allowed frontend origins
# Example for local dev: http://localhost:3000,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4200
